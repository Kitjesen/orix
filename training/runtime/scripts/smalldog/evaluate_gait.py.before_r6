"""Evaluate deterministic SmallDog students with motion-quality measurements."""
# ruff: noqa: E402
import argparse
import json
import math
from pathlib import Path

from isaaclab.app import AppLauncher

parser = argparse.ArgumentParser()
parser.add_argument("--checkpoint", required=True)
parser.add_argument("--output", required=True)
parser.add_argument("--command-vx", type=float, default=0.3)
parser.add_argument("--num-envs", type=int, default=16)
parser.add_argument("--duration-s", type=float, default=10.0)
parser.add_argument("--rough", action="store_true")
parser.add_argument("--refined", action="store_true")
parser.add_argument("--max-terrain-level", type=int, default=0)
AppLauncher.add_app_launcher_args(parser)
args = parser.parse_args()
app = AppLauncher(args).app

import gymnasium as gym
import robot_lab.tasks  # noqa: F401
import torch
from isaaclab.managers import SceneEntityCfg
from isaaclab_rl.rsl_rl import RslRlVecEnvWrapper
from robot_lab.assets.smalldog import CONTRACT
from robot_lab.tasks.smalldog import gait_mdp
from robot_lab.tasks.smalldog.gait_cfg import SmallDogFlatGaitEnvCfg, SmallDogGaitEnvCfg, SmallDogGaitRunnerCfg
from rsl_rl.runners import OnPolicyRunnerCTS

if args.refined:
    from robot_lab.tasks.smalldog.refinement_cfg import (
        SmallDogRefinedFlatGaitEnvCfg,
        SmallDogRefinedGaitEnvCfg,
        SmallDogRefinedGaitRunnerCfg,
    )

    cfg = SmallDogRefinedGaitEnvCfg() if args.rough else SmallDogRefinedFlatGaitEnvCfg()
    runner_cfg = SmallDogRefinedGaitRunnerCfg()
    task = "RobotLab-SmallDog-V67-RoughRefinedGait-v0" if args.rough else "RobotLab-SmallDog-V67-FlatRefinedGait-v0"
else:
    cfg = SmallDogGaitEnvCfg() if args.rough else SmallDogFlatGaitEnvCfg()
    runner_cfg = SmallDogGaitRunnerCfg()
    task = "RobotLab-SmallDog-V67-RoughGait-v0" if args.rough else "RobotLab-SmallDog-V67-FlatGait-v0"

cfg.curriculum.terrain_levels = None
cfg.curriculum.forward_speed = None
if args.rough:
    cfg.scene.terrain.max_init_terrain_level = args.max_terrain_level
cfg.scene.num_envs = args.num_envs
cfg.sim.device = args.device
cfg.seed = 43
for name in vars(cfg.events):
    if name.startswith("randomize_"):
        setattr(cfg.events, name, None)
cfg.events.reset_base.params["pose_range"] = {}
cfg.commands.base_velocity.ranges.lin_vel_x = (args.command_vx, args.command_vx)
cfg.commands.base_velocity.ranges.lin_vel_y = (0, 0)
cfg.commands.base_velocity.ranges.ang_vel_z = (0, 0)
cfg.commands.base_velocity.rel_standing_envs = 0
for group in (cfg.observations.policy, cfg.observations.single_obs):
    group.enable_corruption = False
env = RslRlVecEnvWrapper(gym.make(task, cfg=cfg))
runner = OnPolicyRunnerCTS(env, runner_cfg.to_dict(), log_dir=None, device=args.device)
runner.load(args.checkpoint, load_optimizer=False)
policy = runner.get_inference_policy()
obs = env.get_observations()
u = env.unwrapped
robot = u.scene["robot"]
term = u.action_manager.get_term("joint_pos")
joint_ids, joint_names = robot.find_joints(cfg.actions.joint_pos.joint_names, preserve_order=True)
foot_names = list(gait_mdp.FOOT_NAMES)
foot_ids, resolved = robot.find_bodies(foot_names, preserve_order=True)
assert resolved == foot_names
sensor = u.scene["contact_forces"]
sensor_ids, resolved = sensor.find_bodies(foot_names, preserve_order=True)
assert resolved == foot_names
asset_cfg = SceneEntityCfg("robot")

analysis_after_s = 2.0
if args.duration_s <= analysis_after_s:
    raise ValueError(f"--duration-s must be greater than {analysis_after_s}")
num_steps = round(args.duration_s / u.step_dt)
warmup_steps = round(analysis_after_s / u.step_dt)
samples, terminations = [], 0
terminations_per_env = torch.zeros(args.num_envs, dtype=torch.long, device=u.device)
with torch.inference_mode():
    for step in range(num_steps):
        actions = policy(obs)
        assert torch.isfinite(actions).all()
        assert actions.shape[-1] == len(joint_names)
        obs, reward, dones, _ = env.step(actions)
        terminations += int(dones.sum())
        terminations_per_env += dones.long()
        assert torch.isfinite(robot.data.joint_pos).all()
        if step >= warmup_steps:
            gravity = robot.data.projected_gravity_b
            # Signs follow projected-gravity convention; quality metrics are sign symmetric.
            pitch = torch.asin(gravity[:, 0].clamp(-1.0, 1.0))
            roll = torch.atan2(-gravity[:, 1], -gravity[:, 2])
            clearance, clearance_valid = gait_mdp.foot_clearance(u, asset_cfg)
            samples.append({
                "vx": robot.data.root_lin_vel_b[:, 0].clone(),
                "vy": robot.data.root_lin_vel_b[:, 1].clone(),
                "vz": robot.data.root_lin_vel_b[:, 2].clone(),
                "pitch_rate": robot.data.root_ang_vel_b[:, 1].clone(),
                "yaw_rate": robot.data.root_ang_vel_b[:, 2].clone(),
                "upright": -gravity[:, 2].clone(),
                "pitch": pitch.clone(),
                "roll": roll.clone(),
                "root_link_world_z": robot.data.root_link_pos_w[:, 2].clone(),
                "joint_pos": robot.data.joint_pos[:, joint_ids].clone(),
                "joint_vel": robot.data.joint_vel[:, joint_ids].clone(),
                "clip": ((term.raw_actions * term._scale + term._offset - term.processed_actions).abs() > 1e-6).clone(),
                "foot_clearance": clearance.clone(),
                "clearance_valid": clearance_valid.clone(),
                "foot_z": robot.data.body_link_pos_w[:, foot_ids, 2].clone(),
                "contacts": (sensor.data.net_forces_w[:, sensor_ids].norm(dim=-1) > 1).clone(),
                "torque": robot.data.applied_torque[:, joint_ids].clone(),
            })


def scalar_quality(values: torch.Tensor, env_mask: torch.Tensor) -> dict[str, float]:
    """Summarize time series after excluding every environment that reset."""
    selected = values[:, env_mask]
    if selected.numel() == 0:
        return {
            "mean": math.nan, "std": math.nan, "rms": math.nan,
            "min": math.nan, "max": math.nan, "temporal_std_mean_per_env": math.nan,
            "range_mean_per_env": math.nan,
        }
    return {
        "mean": float(selected.mean()),
        "std": float(selected.std(unbiased=False)),
        "rms": float(selected.square().mean().sqrt()),
        "min": float(selected.min()),
        "max": float(selected.max()),
        "temporal_std_mean_per_env": float(selected.std(dim=0, unbiased=False).mean()),
        "range_mean_per_env": float((selected.amax(dim=0) - selected.amin(dim=0)).mean()),
    }


def degrees(summary: dict[str, float]) -> dict[str, float]:
    return {key: math.degrees(value) for key, value in summary.items()}


vx = torch.stack([x["vx"] for x in samples])
vy = torch.stack([x["vy"] for x in samples])
vz = torch.stack([x["vz"] for x in samples])
pitch_rate = torch.stack([x["pitch_rate"] for x in samples])
yaw_rate = torch.stack([x["yaw_rate"] for x in samples])
pitch = torch.stack([x["pitch"] for x in samples])
roll = torch.stack([x["roll"] for x in samples])
root_link_world_z = torch.stack([x["root_link_world_z"] for x in samples])
joint_pos = torch.stack([x["joint_pos"] for x in samples])
joint_vel = torch.stack([x["joint_vel"] for x in samples])
clearance = torch.stack([x["foot_clearance"] for x in samples])
clearance_valid = torch.stack([x["clearance_valid"] for x in samples])
foot_z = torch.stack([x["foot_z"] for x in samples])
contacts = torch.stack([x["contacts"] for x in samples])
clips = torch.stack([x["clip"] for x in samples])
torques = torch.stack([x["torque"] for x in samples])
no_reset_envs = terminations_per_env == 0
quality_env_count = int(no_reset_envs.sum())
if quality_env_count == 0:
    raise RuntimeError("All environments reset; no uninterrupted rollout remains for quality metrics")
fl_rr = contacts[..., 0] & contacts[..., 3] & ~contacts[..., 1] & ~contacts[..., 2]
fr_rl = contacts[..., 1] & contacts[..., 2] & ~contacts[..., 0] & ~contacts[..., 3]
torque_limits = torch.tensor([14.0 if "calf" in name else 7.0 for name in joint_names], device=u.device)
torque_saturated = torques.abs() >= torque_limits.view(1, 1, -1) * 0.999
joint_range = joint_pos[:, no_reset_envs].amax(dim=0) - joint_pos[:, no_reset_envs].amin(dim=0)
valid_quality_clearance = clearance_valid[:, no_reset_envs]
quality_clearance = clearance[:, no_reset_envs]

foot_clearance_stats = {}
for index, name in enumerate(foot_names):
    valid = valid_quality_clearance[..., index]
    values = quality_clearance[..., index][valid]
    foot_clearance_stats[name] = {
        "valid_fraction": float(valid.float().mean()),
        "mean_m": float(values.mean()),
        "rms_m": float(values.square().mean().sqrt()),
        "p95_m": float(torch.quantile(values, 0.95)),
        "peak_m": float(values.max()),
    }

pitch_rad = scalar_quality(pitch, no_reset_envs)
roll_rad = scalar_quality(roll, no_reset_envs)
report = {
    "asset_version": CONTRACT["version"], "checkpoint": args.checkpoint,
    "task": task, "student_policy": True, "refined": args.refined,
    "num_envs": args.num_envs, "duration_s": args.duration_s, "analysis_after_s": analysis_after_s,
    "command_vx_m_s": args.command_vx, "command_yaw_rate_rad_s": 0.0,
    "terminations": terminations, "terminations_per_env": terminations_per_env.tolist(),
    "quality_no_reset_env_count": quality_env_count,
    "action_joint_order": joint_names,
    "mean_vx_m_s": float(vx.mean()), "mean_abs_vx_error_m_s": float((vx - args.command_vx).abs().mean()),
    "body_velocity_b_m_s": {
        "vx": scalar_quality(vx, no_reset_envs),
        "vy": scalar_quality(vy, no_reset_envs),
        "vz": scalar_quality(vz, no_reset_envs),
    },
    "base_pitch_rate_rad_s": scalar_quality(pitch_rate, no_reset_envs),
    "yaw_rate_error_rad_s": scalar_quality(yaw_rate, no_reset_envs),
    "base_pitch_rad": pitch_rad, "base_pitch_deg": degrees(pitch_rad),
    "base_roll_rad": roll_rad, "base_roll_deg": degrees(roll_rad),
    "root_link_world_z_m": scalar_quality(root_link_world_z, no_reset_envs),
    "mean_upright_cosine": float(torch.stack([x["upright"] for x in samples])[:, no_reset_envs].mean()),
    "actual_joint_position_range_rad_mean_per_env": dict(zip(joint_names, joint_range.mean(dim=0).tolist())),
    "joint_peak_abs_velocity_rad_s": dict(zip(joint_names, joint_vel[:, no_reset_envs].abs().amax(dim=(0, 1)).tolist())),
    "joint_target_clip_fraction": dict(zip(joint_names, clips[:, no_reset_envs].float().mean(dim=(0, 1)).tolist())),
    "terrain_relative_foot_sphere_bottom_clearance": foot_clearance_stats,
    "foot_link_z_range_m_mean_per_env": dict(
        zip(foot_names, (foot_z[:, no_reset_envs].amax(dim=0) - foot_z[:, no_reset_envs].amin(dim=0)).mean(dim=0).tolist())
    ),
    "foot_contact_fraction": dict(zip(foot_names, contacts[:, no_reset_envs].float().mean(dim=(0, 1)).tolist())),
    "joint_peak_abs_torque_nm": dict(zip(joint_names, torques[:, no_reset_envs].abs().amax(dim=(0, 1)).tolist())),
    "joint_mean_abs_mechanical_power_w": dict(
        zip(joint_names, (torques[:, no_reset_envs] * joint_vel[:, no_reset_envs]).abs().mean(dim=(0, 1)).tolist())
    ),
    "joint_torque_limit_nm": dict(zip(joint_names, torque_limits.tolist())),
    "joint_torque_saturation_fraction": dict(zip(joint_names, torque_saturated[:, no_reset_envs].float().mean(dim=(0, 1)).tolist())),
    "fl_rr_only_contact_fraction": float(fl_rr[:, no_reset_envs].float().mean()),
    "fr_rl_only_contact_fraction": float(fr_rl[:, no_reset_envs].float().mean()),
    "all_feet_contact_fraction": float(contacts[:, no_reset_envs].all(dim=-1).float().mean()),
    "note": (
        "Deterministic rollout without exploration or domain randomization. Motion-quality aggregates exclude every "
        "environment that reset, so reset pose discontinuities cannot inflate ranges. Root height is world-frame root-link "
        "Z; foot clearance is the terrain-relative vertical gap under each collision sphere from gait_mdp.foot_clearance(). "
        "Simulation evidence is not hardware proof."
    ),
}
if args.rough:
    terrain = u.scene.terrain
    names = list(cfg.scene.terrain.terrain_generator.sub_terrains)
    weights = torch.tensor([part.proportion for part in cfg.scene.terrain.terrain_generator.sub_terrains.values()], device=u.device)
    fractions = (terrain.terrain_types.float() + 0.5) / cfg.scene.terrain.terrain_generator.num_cols
    types = torch.searchsorted(weights.cumsum(0) / weights.sum(), fractions)
    report["terrain_level_range"] = [int(terrain.terrain_levels.min()), int(terrain.terrain_levels.max())]
    report["terrain_group_note"] = "Groups identify initial terrain tiles; the robot may cross neighboring tiles during rollout."
    report["per_terrain"] = {}
    for index, name in enumerate(names):
        mask = types == index
        if mask.any():
            report["per_terrain"][name] = {
                "num_envs": int(mask.sum()), "terminations": int(terminations_per_env[mask].sum()),
                "mean_vx_m_s": float(vx[:, mask].mean()),
                "mean_abs_vx_error_m_s": float((vx[:, mask] - args.command_vx).abs().mean()),
            }
    report["per_level"] = {}
    for level in range(args.max_terrain_level + 1):
        mask = terrain.terrain_levels == level
        if mask.any():
            report["per_level"][str(level)] = {
                "num_envs": int(mask.sum()), "terminations": int(terminations_per_env[mask].sum()),
                "mean_vx_m_s": float(vx[:, mask].mean()),
                "mean_abs_vx_error_m_s": float((vx[:, mask] - args.command_vx).abs().mean()),
            }
Path(args.output).write_text(json.dumps(report, indent=2))
print("SMALLDOG_GAIT_EVALUATION " + json.dumps(report), flush=True)
env.close()
app.close()
